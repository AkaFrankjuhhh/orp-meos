[Unit]
Description=ORP Politie Personeelsportaal
After=network.target postgresql.service

[Service]
Type=simple
User=defensie
WorkingDirectory=/home/defensie/defensie-personeelsportaal
Environment=NODE_ENV=production
EnvironmentFile=/home/defensie/defensie-personeelsportaal/.env.politie
Environment=ORP_ORGANIZATION=politie
Environment=PORT=3010
Environment=APP_BASE_URL=https://orppolitie.nl
Environment=PORTO_APP_BASE_URL=https://porto.orppolitie.nl
ExecStart=/usr/bin/node /home/defensie/defensie-personeelsportaal/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
