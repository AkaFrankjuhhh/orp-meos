# Defensie Personeelsportaal + publieke formulieren.
orpdefensie.nl, www.orpdefensie.nl, herintrede.orpdefensie.nl, overstap.orpdefensie.nl, otc.orpdefensie.nl, hrb.orpdefensie.nl, ws.orpdefensie.nl, w-s.orpdefensie.nl, hovj.orpdefensie.nl {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3000

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer-when-downgrade
    X-Frame-Options DENY
  }
}

# Centrale klachtenplek voor Politie en Defensie.
klachten.orpoverheid.nl {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3000 {
    header_up Host {host}
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto {scheme}
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer-when-downgrade
    X-Frame-Options DENY
  }
}

klachten.orpdefensie.nl, klachten.orppolitie.nl {
  redir https://klachten.orpoverheid.nl{uri} permanent
}

# Porto draait als eigen service, zodat personeelsportaal deploys OPS niet onderbreken.
porto.orpdefensie.nl {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3002

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer-when-downgrade
    X-Frame-Options DENY
  }
}

# Politie Personeelsportaal + publieke formulieren.
orppolitie.nl, www.orppolitie.nl, herintrede.orppolitie.nl, overstap.orppolitie.nl, trainer.orppolitie.nl, ws.orppolitie.nl, w-s.orppolitie.nl {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3010

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer-when-downgrade
    X-Frame-Options DENY
  }
}

# Politie Porto draait als eigen service.
porto.orppolitie.nl {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3012

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer-when-downgrade
    X-Frame-Options DENY
  }
}

# Centrale overheid-login: kiest op basis van Discord rol het juiste portaal.
orpoverheid.nl, www.orpoverheid.nl {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3020

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer-when-downgrade
    X-Frame-Options DENY
  }
}
