[Unit]
Description=ORP Defensie Porto-Systeem
After=network.target postgresql.service

[Service]
Type=simple
User=defensie
WorkingDirectory=/home/defensie/defensie-personeelsportaal
Environment=NODE_ENV=production
Environment=PORTO_PORT=3002
Environment=PORTO_APP_BASE_URL=https://porto.orpdefensie.nl
ExecStart=/usr/bin/node /home/defensie/defensie-personeelsportaal/porto-server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
