PORT=3000
APP_BASE_URL=http://localhost:3000
PORTO_PORT=3002
PORTO_APP_BASE_URL=http://localhost:3002
SESSION_COOKIE_SECURE=false

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Jullie Discord server en verplichte Defensie rol.
DISCORD_GUILD_ID=
DISCORD_DEFENSIE_ROLE_ID=

# Optioneel: Discord rollen die Defensie Personeelsportaal-permissies automatisch syncen.
DISCORD_KADER_ROLE_ID=
DISCORD_HOOFDOFFICIER_ROLE_ID=
DISCORD_OFFICIERSRAAD_ROLE_ID=

# Optioneel: Discord webhook waar afwezigheidsmeldingen naartoe gaan.
DISCORD_ABSENCE_WEBHOOK_URL=

# Optioneel: personeelsnotificaties. Gebruik de algemene URL of aparte kanalen per actie.
DISCORD_PERSONNEL_WEBHOOK_URL=
DISCORD_HIRE_WEBHOOK_URL=
DISCORD_DISMISSAL_WEBHOOK_URL=
DISCORD_RESIGNATION_WEBHOOK_URL=
DISCORD_BLACKLIST_WEBHOOK_URL=

# Zet op false in productie als Discord verplicht moet zijn.
DEV_ALLOW_UNAUTH=false

# PostgreSQL lokaal/productie. Vervang YOUR_PASSWORD lokaal door je postgres wachtwoord.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/defensie_portaal
DATABASE_SSL=false

# Gebruik json alleen voor oude lokale testdata. Voor live: postgres.
STORAGE_MODE=postgres

# Discord Bot: rollen, nicknames en Porto voicekanalen.
DISCORD_BOT_TOKEN=
DISCORD_NICKNAME_TEMPLATE=[{serviceNumber} {symbols}] {formattedName}
DISCORD_DAILY_SYNC_ENABLED=true
DISCORD_DAILY_SYNC_TIME=05:00
DISCORD_LEGACY_INTERVAL_SYNC_ENABLED=false
DISCORD_NICKNAME_SYNC_INTERVAL_MS=0
DISCORD_JOB_POLL_INTERVAL_MS=5000
DISCORD_JOB_BATCH_SIZE=5
DISCORD_GATEWAY_ENABLED=true
DISCORD_GATEWAY_GUILD_MEMBERS_INTENT=false
# Komma/spatie-gescheiden uitzonderingen: deze profielen worden niet door de bot hernoemd of qua rangrol gesynct.
DISCORD_SYNC_EXCLUDED_DISCORD_IDS=
DISCORD_SYNC_EXCLUDED_PERSON_IDS=

# Discord Bot: rangrollen. Vul per rang de Discord Role ID in. De bot houdt exact 1 rangrol actief.
DISCORD_RANK_LUITENANT_GENERAAL_ROLE_ID=
DISCORD_RANK_GENERAAL_MAJOOR_ROLE_ID=
DISCORD_RANK_BRIGADE_GENERAAL_ROLE_ID=
DISCORD_RANK_KOLONEL_ROLE_ID=
DISCORD_RANK_LUITENANT_KOLONEL_ROLE_ID=
DISCORD_RANK_MAJOOR_ROLE_ID=
DISCORD_RANK_KAPITEIN_ROLE_ID=
DISCORD_RANK_EERSTE_LUITENANT_ROLE_ID=
DISCORD_RANK_TWEEDE_LUITENANT_ROLE_ID=
DISCORD_RANK_KORNET_ROLE_ID=
DISCORD_RANK_ADJUDANT_ROLE_ID=
DISCORD_RANK_OPPERWACHTMEESTER_ROLE_ID=
DISCORD_RANK_WACHTMEESTER_1STE_KLASSER_ROLE_ID=
DISCORD_RANK_WACHTMEESTER_ROLE_ID=
DISCORD_RANK_MARECHAUSSEE_1STE_KLASSER_ROLE_ID=
DISCORD_RANK_MARECHAUSSEE_2DE_KLASSER_ROLE_ID=
DISCORD_RANK_MARECHAUSSEE_3DE_KLASSER_ROLE_ID=
DISCORD_RANK_MARECHAUSSEE_4DE_KLASSER_ROLE_ID=
DISCORD_INTERNE_ZAKEN_ROLE_ID=
DISCORD_OVJ_ROLE_ID=
DISCORD_HOVJ_ROLE_ID=
DISCORD_TRAINER_ROLE_ID=
DISCORD_MENTOR_ROLE_ID=
DISCORD_WS_ROLE_ID=
DISCORD_MEOS_ROLE_ID=1425931664877551708
DISCORD_OPS_ROLE_ID=1423790817738227864
DISCORD_OPCO_ROLE_ID=1424523638526185513
DISCORD_PORTO_CHANNEL_OPS=1511744520260157632
DISCORD_PORTO_CHANNEL_INRAP_01=1511744706810216500
DISCORD_PORTO_CHANNEL_INRAP_02=1511744902831145090
DISCORD_PORTO_CHANNEL_INRAP_03=1511744945029910579
DISCORD_PORTO_CHANNEL_INRAP_04=1511762596007514143
DISCORD_PORTO_CHANNEL_INRAP_05=1511762664743763988
DISCORD_PORTO_CHANNEL_INRAP_06=1511762751142236330
DISCORD_PORTO_CHANNEL_KUSTWACHT=1511745369061462076
DISCORD_PORTO_CHANNEL_STILTE_PORTO=1511745094925942925
PORTO_MAP_ENABLED=false
PORTO_MAP_VISIBLE=false

# Legacy aliases voor oude installaties; gebruik hierboven bij voorkeur DISCORD_PORTO_CHANNEL_*.
DISCORD_VOICE_OPS_CHANNEL_ID=
DISCORD_VOICE_INRAP_1_CHANNEL_ID=
DISCORD_VOICE_INRAP_2_CHANNEL_ID=
DISCORD_VOICE_INRAP_3_CHANNEL_ID=

# Security / performance
# Login-sessies blijven standaard 7 dagen geldig en worden server-side opgeslagen.
SESSION_MAX_AGE_SECONDS=604800
MAX_BODY_BYTES=1048576
PUBLIC_FORM_MAX_BODY_BYTES=9437184
PUBLIC_FORM_MAX_FILE_BYTES=8388608
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_MS=30000
DATABASE_POOL_CONNECT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TX_TIMEOUT_MS=10000
DEV_OVERRIDE_DISCORD_IDS=

# Publieke formulieren op losse subdomeinen. Laat leeg om alleen op te slaan zonder Discord bericht.
DISCORD_PUBLIC_FORMS_WEBHOOK_URL=
DISCORD_FORM_HERINTREDE_WEBHOOK_URL=
DISCORD_FORM_OVERSTAP_WEBHOOK_URL=
DISCORD_FORM_KLACHTEN_WEBHOOK_URL=
DISCORD_FORM_OTC_WEBHOOK_URL=
DISCORD_FORM_HRB_WEBHOOK_URL=
DISCORD_FORM_WS_WEBHOOK_URL=
DISCORD_FORM_HOVJ_WEBHOOK_URL=
