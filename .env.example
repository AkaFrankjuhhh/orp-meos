PORT=3000
APP_BASE_URL=http://localhost:3000

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Jullie Discord server en verplichte Defensie rol.
DISCORD_GUILD_ID=
DISCORD_DEFENSIE_ROLE_ID=

# Optioneel: Discord rollen die Defensie Personeelsportaal-permissies automatisch syncen.
DISCORD_KADER_ROLE_ID=
DISCORD_HOOFDOFFICIER_ROLE_ID=
DISCORD_OFFICIERSRAAD_ROLE_ID=

# Optioneel: Discord webhook waar afwezigheidsmeldingen naartoe gaan.
DISCORD_ABSENCE_WEBHOOK_URL=

# Optioneel: personeelsnotificaties. Gebruik de algemene URL of aparte kanalen per actie.
DISCORD_PERSONNEL_WEBHOOK_URL=
DISCORD_HIRE_WEBHOOK_URL=
DISCORD_DISMISSAL_WEBHOOK_URL=
DISCORD_RESIGNATION_WEBHOOK_URL=
# FiveM urenregistratie. De FiveM resource stuurt alleen sessies door met een toegestane job.
FIVEM_INGEST_SECRET=
FIVEM_ALLOWED_JOBS=kmar,defensie,marechaussee,koninklijke marechaussee

# Zet op false in productie als Discord verplicht moet zijn.
DEV_ALLOW_UNAUTH=false

# PostgreSQL lokaal/productie. Vervang YOUR_PASSWORD lokaal door je postgres wachtwoord.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/defensie_portaal
DATABASE_SSL=false

# Gebruik json alleen voor oude lokale testdata. Voor live: postgres.
STORAGE_MODE=postgres

# Discord Bot: rollen, nicknames en Porto voicekanalen.
DISCORD_BOT_TOKEN=
DISCORD_NICKNAME_TEMPLATE=defensie-personeelsportaal
DISCORD_INTERNE_ZAKEN_ROLE_ID=
DISCORD_OVJ_ROLE_ID=
DISCORD_HOVJ_ROLE_ID=
DISCORD_TRAINER_ROLE_ID=
DISCORD_MENTOR_ROLE_ID=
DISCORD_WS_ROLE_ID=
DISCORD_VOICE_OPS_CHANNEL_ID=
DISCORD_VOICE_INRAP_1_CHANNEL_ID=
DISCORD_VOICE_INRAP_2_CHANNEL_ID=
DISCORD_VOICE_INRAP_3_CHANNEL_ID=
DISCORD_VOICE_KOPPEL_PRIO_1_CHANNEL_ID=
DISCORD_VOICE_KOPPEL_PRIO_2_CHANNEL_ID=
DISCORD_VOICE_KOPPEL_PRIO_3_CHANNEL_ID=
DISCORD_VOICE_KOPPEL_PRIO_4_CHANNEL_ID=
DISCORD_VOICE_KOPPEL_PRIO_5_CHANNEL_ID=
