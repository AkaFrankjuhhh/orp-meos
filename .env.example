# Productie staat standaard dicht voor demo-login; ontwikkeltoegang vereist expliciet
# NODE_ENV=development en DEV_ALLOW_UNAUTH=true.
NODE_ENV=production
DEV_ALLOW_UNAUTH=false

# PostgreSQL lokaal/productie. Vervang YOUR_PASSWORD lokaal door je postgres wachtwoord.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/defensie_portaal
# Voor Politie services in .env.politie:
# DATABASE_URL=postgres://defensie_portal:YOUR_PASSWORD@localhost:5432/politie_portaal
DATABASE_SSL=false
# Zet deze bij Defensie en Politie op dezelfde database-URL voor een gedeelde
# voertuiginbeslagname-lijst. Leeg betekent: gebruik de huidige DATABASE_URL.
VEHICLE_SEIZURE_DATABASE_URL=
VEHICLE_SEIZURE_DATABASE_SSL=false

# Gebruik json alleen voor oude lokale testdata. Voor live: postgres.
STORAGE_MODE=postgres

# Discord Bot: rollen, nicknames en Porto voicekanalen.
DISCORD_BOT_TOKEN=
# Defensie gebruikt spatie als scheiding; Politie gebruikt automatisch " - " via {symbolSeparator}.
DISCORD_NICKNAME_TEMPLATE=[{serviceNumber}{symbolSeparator}{symbols}] {formattedName}
