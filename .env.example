PORT=3000
APP_BASE_URL=http://localhost:3000
PORTO_PORT=3002
PORTO_APP_BASE_URL=http://localhost:3002
PORTO_DUTY_HOURS_ENABLED=true
PORTO_DUTY_HOURS_INTERVAL_MS=600000
PORTO_DUTY_HOURS_TIME_ZONE=Europe/Amsterdam
PORTO_DUTY_HOURS_START_WEEK=2026-W26
OVERHEID_PORT=3020
OVERHEID_APP_BASE_URL=http://localhost:3020
OVERHEID_DEFENSIE_URL=https://orpdefensie.nl
OVERHEID_POLITIE_URL=https://orppolitie.nl
OVERHEID_PUBLIC_FORM_DOMAIN=orpoverheid.nl
SIDE_TASK_PORT=3030
SIDE_TASK_APP_BASE_URL=https://dsi.orpoverheid.nl
SIDE_TASK_BASE_DOMAIN=orpoverheid.nl
# Dezelfde URL als DATABASE_URL in .env.side-tasks, zodat Porto de live
# beschikbaarheid van DSI/HRB/KLu/DNR leest en de normale Discord-worker een
# actieve DSI-naam niet kan overschrijven.
SIDE_TASK_DATABASE_URL=
SIDE_TASK_DATABASE_POOL_MAX=2
# Read-only koppeling voor het herstellen van DSI-nicknames naar de actuele
# gekoppelde naam uit Defensie/Politie Personeelsportaal bij Status 8.
SIDE_TASK_DEFENSIE_DATABASE_URL=
SIDE_TASK_POLITIE_DATABASE_URL=
# Bij een gekoppeld profiel in beide portalen wordt Defensie standaard gekozen.
SIDE_TASK_PORTAL_NICKNAME_PRIORITY=defensie,politie
SESSION_COOKIE_SECURE=false
# defensie of politie. Laat leeg/defensie voor de bestaande Defensie services.
ORP_ORGANIZATION=defensie

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Discord Developer Portal > OAuth2 voor de neventaken app.
# Voeg als redirects toe:
# https://dsi.orpoverheid.nl/auth/discord/callback
# https://hrb.orpoverheid.nl/auth/discord/callback
# https://dnr.orpoverheid.nl/auth/discord/callback
# https://klu.orpoverheid.nl/auth/discord/callback
SIDE_TASK_DISCORD_CLIENT_ID=
SIDE_TASK_DISCORD_CLIENT_SECRET=

# Neventaken Discord: alleen lezen. Geef de bot hier geen Manage Nicknames/Roles.
SIDE_TASK_DISCORD_GUILD_ID=
SIDE_TASK_DISCORD_BOT_TOKEN=
# Vereist voor de rolworker. Schakel in Discord Developer Portal ook Server Members Intent in.
SIDE_TASK_DISCORD_GATEWAY_ENABLED=true
SIDE_TASK_DISCORD_MEMBER_SYNC_INTERVAL_MS=300000

# Main overheid Discord: alleen nodig voor DSI schuilnaam/nickname sync.
MAIN_GOVERNMENT_DISCORD_GUILD_ID=
MAIN_GOVERNMENT_DISCORD_BOT_TOKEN=

# Neventaken toegangsrollen. Komma/spatie-gescheiden role IDs.
SIDE_TASK_DSI_MEMBER_ROLE_IDS=
SIDE_TASK_DSI_LEADERSHIP_ROLE_IDS=
SIDE_TASK_DSI_SUBLEADERSHIP_ROLE_IDS=
# Optioneel: standaard staan ACO en TCO al in de code. Vul alleen in om deze rollen te overschrijven.
# SIDE_TASK_DSI_ACO_ROLE_IDS=1517546277913628695
# SIDE_TASK_DSI_TCO_ROLE_IDS=1517546225715380494
SIDE_TASK_HRB_MEMBER_ROLE_IDS=
SIDE_TASK_HRB_LEADERSHIP_ROLE_IDS=
SIDE_TASK_HRB_SUBLEADERSHIP_ROLE_IDS=
