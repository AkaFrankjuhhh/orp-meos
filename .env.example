# Productie staat standaard dicht voor demo-login; ontwikkeltoegang vereist expliciet
# NODE_ENV=development en DEV_ALLOW_UNAUTH=true.
NODE_ENV=production
DEV_ALLOW_UNAUTH=false

# PostgreSQL lokaal/productie. Vervang YOUR_PASSWORD lokaal door je postgres wachtwoord.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/defensie_portaal
# Voor Politie services in .env.politie:
# DATABASE_URL=postgres://defensie_portal:YOUR_PASSWORD@localhost:5432/politie_portaal
DATABASE_SSL=false

# Gebruik json alleen voor oude lokale testdata. Voor live: postgres.
STORAGE_MODE=postgres

# Discord Bot: rollen, nicknames en Porto voicekanalen.
DISCORD_BOT_TOKEN=
# Defensie gebruikt spatie als scheiding; Politie gebruikt automatisch " - " via {symbolSeparator}.
DISCORD_NICKNAME_TEMPLATE=[{serviceNumber}{symbolSeparator}{symbols}] {formattedName}
DISCORD_DAILY_SYNC_ENABLED=true
DISCORD_DAILY_SYNC_TIME=05:00
DISCORD_LEGACY_INTERVAL_SYNC_ENABLED=false
DISCORD_NICKNAME_SYNC_INTERVAL_MS=0
DISCORD_JOB_POLL_INTERVAL_MS=5000
DISCORD_JOB_BATCH_SIZE=5
# Nieuwe aanmeldingen zonder organisatie-rol worden elke 5 minuten opnieuw gecontroleerd.
DISCORD_REQUIRED_ROLE_RETRY_MS=300000
# 288 pogingen x 5 minuten = maximaal 24 uur wachten op de rol.
DISCORD_REQUIRED_ROLE_MAX_ATTEMPTS=288
DISCORD_GATEWAY_ENABLED=true
# Nodig voor leave logs. Zet ook Server Members Intent aan in de Discord Developer Portal.
DISCORD_GATEWAY_GUILD_MEMBERS_INTENT=true
# /claimizleiding: kopieert een zaakthread naar IZ-Leiding en verwijdert de originele thread.
DISCORD_IZ_LEIDING_CHANNEL_ID=1515083209132478596
DISCORD_IZ_LEIDING_ROLE_ID=1515080646806995045
# Komma/spatie-gescheiden uitzonderingen: deze profielen worden niet door de bot hernoemd of qua rangrol gesynct.
DISCORD_SYNC_EXCLUDED_DISCORD_IDS=
DISCORD_SYNC_EXCLUDED_PERSON_IDS=

