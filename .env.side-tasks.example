SIDE_TASK_PORT=3030
SIDE_TASK_APP_BASE_URL=https://dsi.orpoverheid.nl
SIDE_TASK_BASE_DOMAIN=orpoverheid.nl
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=604800

# Gebruik een aparte neventaken database of een bestaande overheid database.
# Kies bij een aparte database een naam zonder politie/defensie, of zet ORP_ALLOW_CROSS_ORG_DATABASE=true.
STORAGE_MODE=postgres
DATABASE_URL=postgres://defensie_portal:YOUR_PASSWORD@localhost:5432/side_tasks_portal
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TX_TIMEOUT_MS=10000
ORP_ALLOW_CROSS_ORG_DATABASE=true

# OAuth app. Voeg alle vier callbacks toe in Discord Developer Portal.
SIDE_TASK_DISCORD_CLIENT_ID=
SIDE_TASK_DISCORD_CLIENT_SECRET=

# Neventaken Discord: alleen lezen. Geef de bot hier geen Manage Nicknames/Roles.
SIDE_TASK_DISCORD_GUILD_ID=
SIDE_TASK_DISCORD_BOT_TOKEN=

# Main overheid Discord: alleen hier mag de bot DSI nicknames aanpassen.
MAIN_GOVERNMENT_DISCORD_GUILD_ID=
MAIN_GOVERNMENT_DISCORD_BOT_TOKEN=

# Toegangsrollen per neventaak. Komma/spatie-gescheiden role IDs.
SIDE_TASK_DSI_MEMBER_ROLE_IDS=
SIDE_TASK_DSI_LEADERSHIP_ROLE_IDS=
SIDE_TASK_DSI_SUBLEADERSHIP_ROLE_IDS=

SIDE_TASK_HRB_MEMBER_ROLE_IDS=
SIDE_TASK_HRB_LEADERSHIP_ROLE_IDS=
SIDE_TASK_HRB_SUBLEADERSHIP_ROLE_IDS=

SIDE_TASK_DNR_MEMBER_ROLE_IDS=
SIDE_TASK_DNR_LEADERSHIP_ROLE_IDS=
SIDE_TASK_DNR_SUBLEADERSHIP_ROLE_IDS=

SIDE_TASK_KLU_MEMBER_ROLE_IDS=
SIDE_TASK_KLU_LEADERSHIP_ROLE_IDS=
SIDE_TASK_KLU_SUBLEADERSHIP_ROLE_IDS=

# Alleen deze Discord IDs mogen altijd overal in.
SIDE_TASK_DEV_DISCORD_IDS=254572157126967296
